rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read access to the list of doctors
    match /doctors/list {
      allow read: if true;
      allow write: if true; // In a real app, restrict this to admins
    }

    // Allow public read and write access to the roster for demonstration
    match /roster/currentWeek {
      allow read: if true;
      allow write: if true; // In a real app, you'd add validation and auth checks
    }
  }
}

    